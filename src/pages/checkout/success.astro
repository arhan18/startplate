---
import ProductLayout from '@shared/layouts/ProductLayout.astro';
---

<ProductLayout title="Payment Successful — My SaaS">
  <section class="py-24 px-4">
    <div class="max-w-2xl mx-auto text-center">
      <div class="w-16 h-16 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="text-4xl font-bold text-white mb-4">Payment Successful</h1>
      <p class="text-xl text-gray-400 mb-8">Thank you for your purchase!</p>
      <a
        href="/"
        class="inline-block px-8 py-3 bg-cyan-500 text-black font-semibold rounded-lg hover:bg-cyan-400 transition-all"
      >
        Go to Dashboard
      </a>
    </div>
  </section>
</ProductLayout>

---
import ProductLayout from '@shared/layouts/ProductLayout.astro';
import JsonLd from '@shared/components/seo/JsonLd.astro';
import DemoBar from '../components/DemoBar.astro';
import { motion } from 'motion';
---

<ProductLayout
  title="My SaaS — Built with Startplate"
  description="A production-ready SaaS with auth, payments, and everything you need."
  image="/brand/og-image.png"
>
  <DemoBar />
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Background Grid -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(0,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(0,255,255,0.03)_1px,transparent_1px)] bg-[size:64px_64px]"></div>

    <!-- Content -->
    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 tracking-tight">
        Ship Your SaaS
        <span class="text-cyan-400"> in Days</span>
      </h1>
      <p class="text-xl text-gray-400 mb-8 max-w-2xl mx-auto">
        Production-ready auth, payments, admin, and more. Built on Startplate.
      </p>
      <div class="flex gap-4 justify-center">
        <a
          href="#pricing"
          class="px-8 py-3 bg-cyan-500 text-black font-semibold rounded-lg hover:bg-cyan-400 transition-all"
        >
          Get Started
        </a>
        <a
          href="#features"
          class="px-8 py-3 border border-white/20 text-white rounded-lg hover:bg-white/5 transition-all"
        >
          Learn More
        </a>
      </div>
      <p class="mt-6 text-sm text-gray-500">
        Explore the demo:
        <a href="/login/" class="text-cyan-400 underline">Login</a>
        <span class="mx-1">·</span>
        <a href="/dashboard/" class="text-cyan-400 underline">Dashboard</a>
        <span class="mx-1">·</span>
        <a href="/quickstart" class="text-cyan-400 underline">Docs</a>
      </p>
    </div>
  </section>

  <!-- 2-Minute Tour: demo → purchase -->
  <section class="py-16 px-4 border-y border-white/10 bg-white/[0.02]">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-white text-center mb-3">Don't take our word for it. Click it.</h2>
      <p class="text-gray-400 text-center mb-10">A 2-minute tour of exactly what you're buying. Every step works right now.</p>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <a href="/login/" class="block p-5 bg-white/5 border border-white/10 rounded-xl hover:border-cyan-400/50 transition-all">
          <p class="text-cyan-400 font-mono text-sm mb-1">Step 1</p>
          <h3 class="font-semibold text-white mb-1">Log in with any email</h3>
          <p class="text-sm text-gray-400">No password, no signup. See the auth gate buyers get.</p>
        </a>
        <a href="/dashboard/" class="block p-5 bg-white/5 border border-white/10 rounded-xl hover:border-cyan-400/50 transition-all">
          <p class="text-cyan-400 font-mono text-sm mb-1">Step 2</p>
          <h3 class="font-semibold text-white mb-1">Break the dashboard</h3>
          <p class="text-sm text-gray-400">Orders, licenses, seats — the admin buyers get on day one.</p>
        </a>
        <a href="/quickstart" class="block p-5 bg-white/5 border border-white/10 rounded-xl hover:border-cyan-400/50 transition-all">
          <p class="text-cyan-400 font-mono text-sm mb-1">Step 3</p>
          <h3 class="font-semibold text-white mb-1">Read the docs</h3>
          <p class="text-sm text-gray-400">10 articles ship inside: auth, payments, DB, deploy.</p>
        </a>
        <a href="https://startplate.dev/startplate/preview" class="block p-5 bg-cyan-500/10 border border-cyan-500/40 rounded-xl hover:bg-cyan-500/20 transition-all">
          <p class="text-cyan-400 font-mono text-sm mb-1">Step 4</p>
          <h3 class="font-semibold text-white mb-1">Steal this whole site →</h3>
          <p class="text-sm text-gray-400">Every page you just clicked, plus the backend. One payment.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-24 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-4xl font-bold text-white text-center mb-16">
        Everything You Need
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 bg-white/5 border border-white/10 rounded-xl">
          <div class="w-12 h-12 bg-cyan-500/20 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">Auth</h3>
          <p class="text-gray-400">Better Auth with 2FA, magic link, OAuth, and multi-tenancy.</p>
        </div>
        <div class="p-6 bg-white/5 border border-white/10 rounded-xl">
          <div class="w-12 h-12 bg-cyan-500/20 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">Payments</h3>
          <p class="text-gray-400">DodoPayments with MoR, India-friendly, subscriptions, and one-time payments.</p>
        </div>
        <div class="p-6 bg-white/5 border border-white/10 rounded-xl">
          <div class="w-12 h-12 bg-cyan-500/20 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">Admin</h3>
          <p class="text-gray-400">Dashboard, analytics, user management, and super admin role.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing" class="py-24 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-4xl font-bold text-white text-center mb-16">
        Simple Pricing
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 bg-white/5 border border-white/10 rounded-xl">
          <h3 class="text-xl font-semibold text-white mb-2">Starter</h3>
          <div class="text-4xl font-bold text-white mb-4">$199</div>
          <ul class="space-y-3 text-gray-400 mb-8">
            <li>Full template</li>
            <li>1 project</li>
            <li>Email support</li>
          </ul>
          <!-- BUYER: point this at your checkout (e.g. your Dodo/Stripe payment link) -->
          <a href="https://startplate.dev/startplate/preview" class="block text-center w-full py-3 border border-white/20 text-white rounded-lg hover:bg-white/5 transition-all">
            Get Started
          </a>
        </div>
        <div class="p-8 bg-cyan-500/10 border border-cyan-500/30 rounded-xl relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-cyan-500 text-black text-xs font-semibold rounded-full">
            Popular
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">Pro</h3>
          <div class="text-4xl font-bold text-white mb-4">$399</div>
          <ul class="space-y-3 text-gray-400 mb-8">
            <li>Everything in Starter</li>
            <li>5 projects</li>
            <li>Priority support</li>
          </ul>
          <!-- BUYER: point this at your checkout (e.g. your Dodo/Stripe payment link) -->
          <a href="https://startplate.dev/startplate/preview" class="block text-center w-full py-3 bg-cyan-500 text-black font-semibold rounded-lg hover:bg-cyan-400 transition-all">
            Get Started
          </a>
        </div>
        <div class="p-8 bg-white/5 border border-white/10 rounded-xl">
          <h3 class="text-xl font-semibold text-white mb-2">Pro+</h3>
          <div class="text-4xl font-bold text-white mb-4">$699</div>
          <ul class="space-y-3 text-gray-400 mb-8">
            <li>Everything in Pro</li>
            <li>Unlimited projects</li>
            <li>White-label ready</li>
          </ul>
          <!-- BUYER: point this at your checkout (e.g. your Dodo/Stripe payment link) -->
          <a href="https://startplate.dev/startplate/preview" class="block text-center w-full py-3 border border-white/20 text-white rounded-lg hover:bg-white/5 transition-all">
            Get Started
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold text-white mb-6">
        Ready to Ship?
      </h2>
      <p class="text-xl text-gray-400 mb-8">
        Start building your SaaS today with Startplate.
      </p>
      <a
        href="#pricing"
        class="inline-block px-8 py-3 bg-cyan-500 text-black font-semibold rounded-lg hover:bg-cyan-400 transition-all"
      >
        Get Started Now
      </a>
    </div>
  </section>
</ProductLayout>

<JsonLd
  data={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "My SaaS",
    "url": "https://yourdomain.com",
  }}
/>

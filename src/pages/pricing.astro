---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pricing — My SaaS">
  <section class="py-24 px-4">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-4xl font-bold text-white text-center mb-16">
        Simple Pricing
      </h1>
      <p class="text-xl text-gray-400 text-center mb-16 max-w-2xl mx-auto">
        No subscriptions. No recurring fees. Choose your plan and start building.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 bg-white/5 border border-white/10 rounded-xl">
          <h3 class="text-xl font-semibold text-white mb-2">Starter</h3>
          <div class="text-4xl font-bold text-white mb-4">$199</div>
          <ul class="space-y-3 text-gray-400 mb-8">
            <li>Full template</li>
            <li>1 project</li>
            <li>Email support</li>
          </ul>
          <button class="w-full py-3 border border-white/20 text-white rounded-lg hover:bg-white/5 transition-all">
            Get Started
          </button>
        </div>
        <div class="p-8 bg-cyan-500/10 border border-cyan-500/30 rounded-xl relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-cyan-500 text-black text-xs font-semibold rounded-full">
            Popular
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">Pro</h3>
          <div class="text-4xl font-bold text-white mb-4">$399</div>
          <ul class="space-y-3 text-gray-400 mb-8">
            <li>Everything in Starter</li>
            <li>5 projects</li>
            <li>Priority support</li>
          </ul>
          <button class="w-full py-3 bg-cyan-500 text-black font-semibold rounded-lg hover:bg-cyan-400 transition-all">
            Get Started
          </button>
        </div>
        <div class="p-8 bg-white/5 border border-white/10 rounded-xl">
          <h3 class="text-xl font-semibold text-white mb-2">Pro+</h3>
          <div class="text-4xl font-bold text-white mb-4">$699</div>
          <ul class="space-y-3 text-gray-400 mb-8">
            <li>Everything in Pro</li>
            <li>Unlimited projects</li>
            <li>White-label ready</li>
          </ul>
          <button class="w-full py-3 border border-white/20 text-white rounded-lg hover:bg-white/5 transition-all">
            Get Started
          </button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

# ============================================================
# Startplate Configuration
# ============================================================

# Database (Turso)
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your-token"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="your-secret-here"
BETTER_AUTH_URL="http://localhost:4321"

# Payments — DodoPayments default, Stripe + Lemon Squeezy supported
# Switch provider: PAYMENT_PROVIDER="dodo" | "stripe" | "lemonsqueezy"
PAYMENT_PROVIDER="dodo"
DODO_PAYMENTS_API_KEY="dodo_test_xxx"
DODO_PAYMENTS_WEBHOOK_SECRET="whsec_xxx"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
LEMONSQUEEZY_API_KEY="xxx"
LEMONSQUEEZY_STORE_ID="xxx"
LEMONSQUEEZY_WEBHOOK_SECRET="xxx"

# Email (Resend)
RESEND_API_KEY="re_xxx"
EMAIL_FROM="noreply@yourdomain.com"

# Analytics (PostHog)
PUBLIC_POSTHOG_KEY="phc_xxx"
PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# AI (Cloudflare Workers AI)
CLOUDFLARE_API_TOKEN="xxx"
CLOUDFLARE_ACCOUNT_ID="xxx"

# File Storage (Cloudflare R2)
R2_ACCOUNT_ID="xxx"
R2_ACCESS_KEY_ID="xxx"
R2_SECRET_ACCESS_KEY="xxx"
R2_BUCKET_NAME="xxx"

# Monitoring (Optional)
SENTRY_DSN=""

---
interface Props {
  notifications: Array<{
    id: string;
    title: string;
    message: string;
    type: 'info' | 'success' | 'warning' | 'error';
    read: boolean;
    actionUrl?: string;
    createdAt: string;
  }>;
  class?: string;
}

const { notifications, class: className = '' } = Astro.props;

const typeColors = {
  info: 'border-blue-500 bg-blue-500/10',
  success: 'border-green-500 bg-green-500/10',
  warning: 'border-yellow-500 bg-yellow-500/10',
  error: 'border-red-500 bg-red-500/10',
};

const typeIcons = {
  info: 'ℹ️',
  success: '✓',
  warning: '⚠️',
  error: '✕',
};
---

<div class:list={['flex flex-col gap-3', className]}>
  {notifications.length === 0 ? (
    <p class="text-center py-8" style="color: hsl(var(--muted-foreground));">
      No notifications
    </p>
  ) : (
    notifications.map((notif) => (
      <div
        class:list={[
          'p-4 rounded-lg border-l-4 transition-opacity',
          typeColors[notif.type],
          notif.read && 'opacity-60',
        ]}
        data-notification-id={notif.id}
      >
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <span>{typeIcons[notif.type]}</span>
              <h4 class="font-medium text-sm" style="color: hsl(var(--foreground));">
                {notif.title}
              </h4>
              {notif.read && (
                <span class="text-xs px-2 py-0.5 rounded" style="background: hsl(var(--muted)); color: hsl(var(--muted-foreground));">
                  Read
                </span>
              )}
            </div>
            <p class="text-sm" style="color: hsl(var(--muted-foreground));">
              {notif.message}
            </p>
            <p class="text-xs mt-2" style="color: hsl(var(--muted-foreground)); opacity: 0.7;">
              {new Date(notif.createdAt).toLocaleDateString()}
            </p>
          </div>
          
          <div class="flex items-center gap-2">
            {notif.actionUrl && (
              <a
                href={notif.actionUrl}
                class="text-xs px-3 py-1 rounded"
                style="background: hsl(var(--primary)); color: hsl(var(--primary-foreground));"
              >
                View
              </a>
            )}
            {!notif.read && (
              <button
                class="mark-read-btn text-xs px-3 py-1 rounded"
                style="background: hsl(var(--muted)); color: hsl(var(--muted-foreground));"
                data-id={notif.id}
              >
                Mark read
              </button>
            )}
          </div>
        </div>
      </div>
    ))
  )}
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const markReadBtns = document.querySelectorAll('.mark-read-btn');
    
    markReadBtns.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.dataset.id;
        
        try {
          await fetch(`/api/notifications/${id}/read`, { method: 'POST' });
          const card = target.closest('[data-notification-id]');
          card?.classList.add('opacity-60');
          target.remove();
        } catch (error) {
          console.error('Failed to mark as read:', error);
        }
      });
    });
  });
</script>

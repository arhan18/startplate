---
interface Props {
  count: number;
  class?: string;
}

const { count, class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 text-xs font-medium rounded-full',
    count > 0 ? 'bg-red-500 text-white' : 'bg-gray-500/20 text-gray-400',
    className,
  ]}
>
  {count > 99 ? '99+' : count}
</span>

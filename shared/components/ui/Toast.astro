---
interface Props {
  id?: string;
  class?: string;
}

const { id = 'toast-container', class: className = '' } = Astro.props;
---

<div
  id={id}
  class:list={['fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm', className]}
/>

<script>
  // Toast utility functions
  window.showToast = function(
    message: string,
    type: 'success' | 'error' | 'warning' | 'info' = 'info',
    duration: number = 3000
  ) {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = 'toast animate-slide-in';

    const colors = {
      success: { bg: 'hsl(var(--success) / 0.1)', border: 'hsl(var(--success) / 0.2)', text: 'hsl(var(--success))' },
      error: { bg: 'hsl(var(--destructive) / 0.1)', border: 'hsl(var(--destructive) / 0.2)', text: 'hsl(var(--destructive))' },
      warning: { bg: 'hsl(var(--warning) / 0.1)', border: 'hsl(var(--warning) / 0.2)', text: 'hsl(var(--warning))' },
      info: { bg: 'hsl(var(--muted))', border: 'hsl(var(--border))', text: 'hsl(var(--foreground))' },
    };

    const color = colors[type];

    toast.innerHTML = `
      <div class="flex items-center gap-3">
        <div class="flex-shrink-0">
          ${type === 'success' ? `
            <svg class="w-5 h-5" style="color: ${color.text}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          ` : type === 'error' ? `
            <svg class="w-5 h-5" style="color: ${color.text}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          ` : type === 'warning' ? `
            <svg class="w-5 h-5" style="color: ${color.text}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          ` : `
            <svg class="w-5 h-5" style="color: ${color.text}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          `}
        </div>
        <p class="text-sm font-medium" style="color: ${color.text}">${message}</p>
      </div>
    `;

    toast.style.backgroundColor = color.bg;
    toast.style.borderColor = color.border;

    container.appendChild(toast);

    // Auto-remove after duration
    setTimeout(() => {
      toast.style.animation = 'fadeOut 0.3s ease-out forwards';
      setTimeout(() => toast.remove(), 300);
    }, duration);
  };
</script>

<style>
  @keyframes fadeOut {
    from { opacity: 1; transform: translateX(0); }
    to { opacity: 0; transform: translateX(16px); }
  }
</style>

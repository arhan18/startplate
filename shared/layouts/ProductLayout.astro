---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  ogType?: string;
  jsonLd?: Record<string, any>;
}

const {
  title,
  description = "Builder & indie hacker making weird web products.",
  image = "/og-default.png",
  canonical,
  ogType = "website",
  jsonLd,
} = Astro.props;

const url = Astro.url.href;
const canonicalUrl = canonical || url;
const siteUrl = "https://arhanahmad.com";
const ogImageUrl = image.startsWith("http") ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="en" class="dark overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Arhan Ahmad" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:creator" content="@ahmadarhankhan" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme color -->
    <meta name="theme-color" content="#0a0a0a" />

    <title>{title}</title>

    <!-- Theme initialization (prevents flash) -->
    <script is:inline>
      (function() {
        try {
          var d = document.documentElement;
          var c = d.classList;
          c.remove('light', 'dark');
          var e = localStorage.getItem('theme');
          if ('system' === e || (!e && true)) {
            var t = '(prefers-color-scheme: dark)';
            var m = window.matchMedia(t);
            if (m.media !== t || m.matches) {
              d.style.colorScheme = 'dark';
              c.add('dark');
            } else {
              d.style.colorScheme = 'light';
              c.add('light');
            }
          } else if (e) {
            c.add(e || '');
          }
          if (e === 'light' || e === 'dark') d.style.colorScheme = e;
        } catch (e) {}
      })();
    </script>

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen bg-background text-foreground overflow-x-hidden">
    <slot />
  </body>
</html>

<style is:global>
  @import '../../shared/styles/shared.css';
</style>

---
interface Props {
  name: string;
  email: string;
  loginUrl?: string;
}

const { name, email, loginUrl = 'https://yourapp.com/login' } = Astro.props;
---

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to Our Platform</title>
</head>
<body style="margin:0;padding:0;background-color:#0a0a0a;font-family:'JetBrains Mono',monospace;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#0a0a0a;padding:40px 20px;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="background-color:#111;border:1px solid #222;border-radius:8px;">
          <!-- Header -->
          <tr>
            <td style="padding:32px 40px;border-bottom:1px solid #222;">
              <h1 style="margin:0;font-size:24px;color:#00ff41;font-weight:bold;">
                Welcome, {name}!
              </h1>
            </td>
          </tr>
          
          <!-- Body -->
          <tr>
            <td style="padding:32px 40px;">
              <p style="margin:0 0 16px;color:#888;font-size:14px;line-height:1.6;">
                Your account has been created successfully. You're now part of our platform.
              </p>
              
              <p style="margin:0 0 24px;color:#888;font-size:14px;line-height:1.6;">
                Here's what you can do next:
              </p>
              
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
                <tr>
                  <td style="padding:12px 16px;background-color:#1a1a1a;border-radius:4px;margin-bottom:8px;">
                    <span style="color:#00ff41;">→</span> <span style="color:#ccc;">Complete your profile</span>
                  </td>
                </tr>
                <tr><td style="height:8px;"></td></tr>
                <tr>
                  <td style="padding:12px 16px;background-color:#1a1a1a;border-radius:4px;">
                    <span style="color:#00ff41;">→</span> <span style="color:#ccc;">Connect your first project</span>
                  </td>
                </tr>
                <tr><td style="height:8px;"></td></tr>
                <tr>
                  <td style="padding:12px 16px;background-color:#1a1a1a;border-radius:4px;">
                    <span style="color:#00ff41;">→</span> <span style="color:#ccc;">Explore the dashboard</span>
                  </td>
                </tr>
              </table>
              
              <a href={loginUrl} style="display:inline-block;padding:12px 24px;background-color:#00ff41;color:#0a0a0a;text-decoration:none;border-radius:4px;font-weight:bold;font-size:14px;">
                Go to Dashboard →
              </a>
            </td>
          </tr>
          
          <!-- Footer -->
          <tr>
            <td style="padding:24px 40px;border-top:1px solid #222;">
              <p style="margin:0;font-size:12px;color:#555;">
                Questions? Reply to this email or visit our docs.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
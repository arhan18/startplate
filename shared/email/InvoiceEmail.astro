---
interface Props {
  name: string;
  invoiceId: string;
  amount: string;
  date: string;
  items: Array<{ name: string; amount: string }>;
  downloadUrl?: string;
}

const { name, invoiceId, amount, date, items, downloadUrl } = Astro.props;
---

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Invoice {invoiceId}</title>
</head>
<body style="margin:0;padding:0;background-color:#0a0a0a;font-family:'JetBrains Mono',monospace;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#0a0a0a;padding:40px 20px;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="background-color:#111;border:1px solid #222;border-radius:8px;">
          <tr>
            <td style="padding:32px 40px;border-bottom:1px solid #222;">
              <h1 style="margin:0;font-size:24px;color:#00ff41;font-weight:bold;">
                Invoice {invoiceId}
              </h1>
              <p style="margin:8px 0 0;font-size:14px;color:#888;">
                {date}
              </p>
            </td>
          </tr>
          
          <tr>
            <td style="padding:32px 40px;">
              <p style="margin:0 0 24px;color:#888;font-size:14px;line-height:1.6;">
                Hi {name},
              </p>
              
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
                <tr style="border-bottom:1px solid #222;">
                  <td style="padding:12px 0;color:#888;font-size:13px;font-weight:bold;">ITEM</td>
                  <td align="right" style="padding:12px 0;color:#888;font-size:13px;font-weight:bold;">AMOUNT</td>
                </tr>
                {items.map((item) => (
                  <tr style="border-bottom:1px solid #1a1a1a;">
                    <td style="padding:12px 0;color:#ccc;font-size:14px;">{item.name}</td>
                    <td align="right" style="padding:12px 0;color:#ccc;font-size:14px;">{item.amount}</td>
                  </tr>
                ))}
                <tr>
                  <td style="padding:16px 0 0;color:#00ff41;font-size:16px;font-weight:bold;">TOTAL</td>
                  <td align="right" style="padding:16px 0 0;color:#00ff41;font-size:16px;font-weight:bold;">{amount}</td>
                </tr>
              </table>
              
              {downloadUrl && (
                <a href={downloadUrl} style="display:inline-block;padding:12px 24px;background-color:#00ff41;color:#0a0a0a;text-decoration:none;border-radius:4px;font-weight:bold;font-size:14px;">
                  Download PDF →
                </a>
              )}
            </td>
          </tr>
          
          <tr>
            <td style="padding:24px 40px;border-top:1px solid #222;">
              <p style="margin:0;font-size:12px;color:#555;">
                Payment processed via DodoPayments. Questions? Contact support.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>